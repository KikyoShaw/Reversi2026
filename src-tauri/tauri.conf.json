{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reversi2026",
  "version": "0.1.0",
  "identifier": "com.kikyoshaw.reversi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1440",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "黑白棋 · Reversi", "width": 1140, "height": 860, "minWidth": 980, "minHeight": 760, "center": true, "resizable": true }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Game",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "黑白棋 · Reversi，人机、本地双人与局域网对弈",
    "windows": { "nsis": { "languages": ["SimpChinese", "English"], "displayLanguageSelector": false } }
  }
}